// http/response.stra - canned responses, the reason-phrase switch, and the Connection: header rule.
// C counterpart: http/http_msg.h (reason_phrase, mk_resp, init_responses, conn_header).
package http

struct ResponseTable {
    ok: Resp, okClose: Resp, okKa: Resp, notFound: Resp, badRequest: Resp, headersTooLarge: Resp, payloadTooLarge: Resp, notImplemented: Resp, serverError: Resp

    static fn build(): ResponseTable {   // runs once at startup
        return ResponseTable {
            ok:                makeResponse(200, "", HELLO, true),
            okClose:          makeResponse(200, "Connection: close\r\n", HELLO, false),
            okKa:             makeResponse(200, "Connection: keep-alive\r\n", HELLO, true),   // for HTTP/1.0 clients that ask for it
            notFound:         makeResponse(404, "Connection: close\r\n", "not found\n", false),
            badRequest:       makeResponse(400, "Connection: close\r\n", "bad request\n", false),
            headersTooLarge: makeResponse(431, "Connection: close\r\n", "headers too large\n", false),
            payloadTooLarge: makeResponse(413, "Connection: close\r\n", "payload too large\n", false),
            notImplemented:   makeResponse(501, "Connection: close\r\n", "not implemented\n", false),
            serverError:      makeResponse(500, "", "internal error\n", true),              // keep-alive: a handler exception does not end the connection
        }
    }
}

// A switch on a plain value: arms may list several values with commas, and a non-enum switch needs `default`.
fn reasonPhrase(code: u16): string {
    switch (code) {
        200           -> { return "OK" }
        301, 302, 307 -> { return "Redirect" }
        400           -> { return "Bad Request" }
        404           -> { return "Not Found" }
        413           -> { return "Payload Too Large" }
        431           -> { return "Request Header Fields Too Large" }
        500           -> { return "Internal Server Error" }
        501           -> { return "Not Implemented" }
        default       -> { return "Other" }
    }
}

fn makeResponse(code: u16, connHdr: string, body: string, keepAlive: bool): Resp {
    let text = "HTTP/1.1 " + code + " " + reasonPhrase(code) + "\r\nContent-Type: text/plain\r\nContent-Length: " + body.length + "\r\n"
             + connHdr + "\r\n" + body
    return Resp { bytes: leak(text.toBytes()), keepAlive: keepAlive }   // lives for the whole run
}

// Does this request ask to keep the connection open? Case-insensitive Connection: header; HTTP/1.1 defaults to yes, 1.0 to no.
fn keepsAlive(head: u8[]&): bool {
    let http11 = head.contains("HTTP/1.1\r\n")
    for (line in head.lines().skip(1)) {
        if (line.startsWithIgnoreCase("connection:")) {
            if (line.containsIgnoreCase("close")) return false
            if (line.containsIgnoreCase("keep-alive")) return true
        }
    }
    return http11
}
