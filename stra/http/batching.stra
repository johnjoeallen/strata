// http/batching.stra - opt-in response batching for a sequential connection loop (off by default; superseded for most uses by the pipelined loop).
// C counterpart: the BATCH_N blocks of handle_step (server.c).
package http
import runtime

// ---------- the alternative: opt-in response batching for a sequential loop (HTTP library feature, off by default) ----------
// Superseded for most uses by 5b, which gets the same batching as a consequence of its structure. Kept because it needs no
// child vthreads and still wins for handlers that are all very cheap; see results/http.md for what it costs.
//
// A BatchedWriter holds finished responses ONLY while the next request is already fully buffered, so nothing waits on a
// timer. The library flushes it when: no complete request remains buffered, `maxBatch` responses are held, the next
// handler could park (known statically from the handler's may-park effect) or takes over the connection (streaming
// body, protocol upgrade), and when the connection ends by ANY path.
//
// Ending the connection is what cleanup() is for: leaving the loop normally, by an exception, on peer reset or on
// cancellation runs it, and it makes one best-effort, non-parking send of whatever is held. Cleanup never parks (a
// destructor that waited could stall task teardown); code that must know the data went out calls flush(), which may park.
struct BatchedWriter {
    conn: Conn&
    out: OutBuf? = null             // exists only while responses are held
    length: usize = 0
    held: usize = 0
    maxBatch: usize             // bound 1: at most this many responses are held
    maxHold: Duration           // bound 2: the oldest held response is never held longer than this when the library
                                 // gets to decide (checked before each handler and before holding another response)
    oldest: Instant = Instant.now()

    static fn of(conn: Conn&, maxBatch: usize, maxHold: Duration): BatchedWriter {
        return BatchedWriter { conn: conn, maxBatch: maxBatch, maxHold: maxHold }
    }
    fn hold(resp: Resp) {   // copies into `out`
        if (out == null) { self.out = outPool.get(); self.length = 0; self.oldest = Instant.now() }
        out.data[length .. length + resp.bytes.length].copyFrom(resp.bytes)
        self.length += resp.bytes.length
        self.held++
    }
    // May another response be held? Checked by the library before it decides to hold, never inside a handler.
    fn hasRoom(): bool {
        if (held >= maxBatch || length + MAX_RESPONSE > OUTSZ) return false
        return held == 0 || Instant.now() - oldest < maxHold
    }
    fn flush() throws IoError {   // the explicit way to be sure
        if (held == 0) return
        writeAll(conn, out.data[..length])   // waits for send-buffer space
        self.out = null                                                                            // back to the pool
        self.length = 0
        self.held = 0
    }
    fn cleanup() { if (held > 0) conn.trySend(out.data[..length]) }   // best effort, never parks, never throws
}

// maxHold is only checked BETWEEN handlers and a running handler cannot be interrupted, so it cannot protect a batch from
// one long handler; the route's `cost` declaration (section 2) does, by flushing before an unbounded route runs.
// `[nopark]` is part of the handler's type: the function passed here must be one the compiler has shown can never park, so batching is allowed.
// A handler that may park, including one marked [yield], is not accepted.
fn handleBatched(conn: Conn, handler: fn[nopark](u8[]&): Resp, maxBatch: usize, cfg: ServerConfig&): Ending throws IoError, TooLarge {
    var input = Reader.of(conn, cfg)
    var out = BatchedWriter.of(conn, maxBatch, 50us)
    while (true) {
        let req = input.nextRequest()   // an exception here ends the function; out.cleanup() flushes best-effort
        if (req == null) break
        let resp = handler(input.head(req))
        out.hold(resp)
        if (!resp.keepAlive || !out.hasRoom() || !input.hasCompleteRequest()) out.flush()   // next request not here yet, or no room
        if (!resp.keepAlive) return Ending.ServerClosed
    }
    return Ending.ClientClosed
}
