// http/route.stra - routes: which reader a handler uses, what a route declares (safe, cost), and how a handler is run.
// C counterpart: route() and the simulated handlers in server.c (the route TABLE itself is part of the server).
import http.types
import http.response
import http.body

// ---------- routes and handlers ----------
// Each route states, up front, what the library needs to know to run requests concurrently and safely:
//   safe      the method has no side effects the next request could observe (GET/HEAD). Unsafe requests (POST, PUT,
//             DELETE) are barriers: nothing in flight when they start, nothing starts behind them until they finish.
//   cost      Bounded(d) or Unbounded. An unbounded route is a barrier BEFORE it: responses that are already complete are
//             sent before it starts. Undeclared routes are Unbounded. The library measures bounded handlers and reports a
//             violation (counter + log); it never changes behaviour.
// A handler may throw anything: its type says `throws Exception`. runHandler (below) turns that into a 500.
// Which reader a route uses is part of its handler. Both readers belong to the runtime library, not the language, and share one stream decoder.
//   Plain   no body. A request that carries one is refused (400) and the connection closes.
//   Api     the STANDARD reader: the whole body is read into memory before the handler runs, at most ServerConfig.maxBody (1 MB by default).
//           It needs no files, and `bytes()` cannot fail. This is what ordinary API routes use.
//   Upload  the UPLOAD reader, for file uploads and other large bodies: the route opts in explicitly and states its own limit (never above
//           ServerConfig.uploadMax). The body is written to an unnamed temporary file as it arrives, so memory use does not grow with its size;
//           the handler gets the finished file to link into place, read, or map. Multipart would be the same mechanism applied once per part.
// Either way the limit is enforced BEFORE the handler runs: a Content-Length over it is refused (413) before a single body byte is read, and
// a chunked body as soon as a chunk would take it over. Nothing here parses a body of any size into a value; large documents get a streaming
// parser over the mapped file.
enum Handler {
    Plain(fn(u8[]&): Resp throws Exception)
    Api(fn(u8[]&, Body&): Resp throws Exception)
    Upload(u64, fn(u8[]&, Upload&): Resp throws Exception)        // (limit, handler)

    fn isPlain(): bool {
        switch (self) {
            Plain(_) -> { return true }
            Api(_), Upload(_, _) -> { return false }
        }
    }
}

// What the readers hand to runHandler.
enum Payload {
    NoPayload
    Mem(Body)
    Spooled(Upload)
}

struct Route {
    method: Method
    path: Pattern
    handler: Handler
    safe: bool
    cost: Cost

    static fn get(path: string, handler: fn(u8[]&): Resp throws Exception, cost: Cost): Route {
        return Route { method: Method.Get, path: Pattern(path), handler: Handler.Plain(handler), safe: true, cost: cost }
    }
    static fn post(path: string, handler: fn(u8[]&): Resp throws Exception, cost: Cost): Route {
        return Route { method: Method.Post, path: Pattern(path), handler: Handler.Plain(handler), safe: false, cost: cost }
    }
    // A route with a body is unsafe by definition (a barrier both ways).
    static fn postApi(path: string, handler: fn(u8[]&, Body&): Resp throws Exception, cost: Cost): Route {
        return Route { method: Method.Post, path: Pattern(path), handler: Handler.Api(handler), safe: false, cost: cost }
    }
    static fn upload(path: string, handler: fn(u8[]&, Upload&): Resp throws Exception, cost: Cost, limit: u64): Route {
        return Route { method: Method.Post, path: Pattern(path), handler: Handler.Upload(limit, handler), safe: false, cost: cost }
    }
}


fn runHandler(route: Route&, head: u8[]&, payload: Payload, table: ResponseTable&): Resp {
    try {
        switch (route.handler) {
            Plain(h)      -> { return h(head) }
            Api(h)        -> {
                switch (payload) {
                    Mem(body)                -> { return h(head, body) }   // the library read the body first
                    NoPayload, Spooled(_)    -> { return table.serverError }                      // cannot happen: admission pairs them
                }
            }
            Upload(_, h)  -> {
                switch (payload) {
                    Spooled(upload)          -> { return h(head, upload) }
                    NoPayload, Mem(_)        -> { return table.serverError }
                }
            }
        }
    } catch (e: Exception) {
        log(e)
        return table.serverError
    }
}
