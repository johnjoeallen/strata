// http/pipeline.stra - what a pipelined connection keeps: the completed-prefix buffer and the ordered set of in-flight requests.
// C counterpart: inline in conc_step (server.c): the ring of Req, the collect loop, and the barrier checks.
import runtime.leaves
import runtime.ring
import http.types
import http.route

// What gets sent: completed responses appended in request order into one pool buffer, ready for one write. Dropping a
// Prefix returns its buffer to the pool.
struct Prefix {
    out: OutBuf? = null
    length: usize = 0
    closes: bool = false

    static fn empty(): Prefix { return Prefix {} }
    fn hasRoomFor(n: usize): bool { return length + n <= OUTSZ }
    fn append(resp: Resp) {
        if (out == null) self.out = outPool.get()
        out.data[length .. length + resp.bytes.length].copyFrom(resp.bytes)
        self.length += resp.bytes.length
        if (!resp.keepAlive) self.closes = true             // nothing is admitted after a closing request, so it is the last
    }
    fn isEmpty(): bool { return length == 0 }
    fn bytes(): u8[]& { return (out == null) ? NO_BYTES : out.data[..length] }
    fn endsWithClose(): bool { return closes }
}

// InFlight is the pipeline of ONE connection. It owns the ring and the rules that need to see the whole pipeline. A request
// in flight is just a Task<Resp>: a child that may still be running, or `Task.completed(resp)` for an inline or error response.
struct InFlight {
    ring: Ring<Task<Resp>>                                   // the ring's capacity is the depth
    unsafeBusy: bool = false                                // an unsafe request is in flight

    static fn of(depth: usize): InFlight { return InFlight { ring: Ring.withCapacity(depth) } }
    fn length(): usize { return ring.length() }
    fn isEmpty(): bool { return ring.isEmpty() }
    fn push(t: Task<Resp>) { ring.push(t) }
    fn markUnsafe() { self.unsafeBusy = true }              // cleared when the pipeline drains

    // The barrier rules. An unsafe request, or a route declared unbounded, is admitted only when nothing is in flight;
    // nothing is admitted while an unsafe request is in flight.
    fn admits(route: Route&): bool {
        if (unsafeBusy) return false
        if (!route.safe || route.cost.isUnbounded()) return isEmpty()
        return true
    }

    // Moves the longest run of FINISHED requests, starting from the oldest, out of the ring and into a Prefix. It stops at
    // the first request that has not finished, which is what keeps responses in request order, and when the output buffer
    // is full (the caller sends, then collects again). Returns 0..length() entries.
    fn takeCompletedPrefix(): Prefix {
        var prefix = Prefix.empty()
        while (true) {
            let front = ring.front()
            if (front == null || !front.isDone()) break
            if (!prefix.hasRoomFor(front.peek().bytes.length)) break
            prefix.append(ring.pop().result())   // frees the child's frame
        }
        if (ring.isEmpty()) self.unsafeBusy = false
        return prefix
    }

    // Is the oldest request finished? Then there is something to collect and the connection must not park.
    fn hasFinished(): bool {
        let front = ring.front()
        return front != null && front.isDone()
    }

    // A wait source for waitAny. Nothing is lost if a child finishes before the wait starts: the connection re-checks every
    // done flag each time it runs, and only parks after a pass in which nothing changed.
    fn childFinished(): Wakeup { return Wakeup.scopeChild() }
}
